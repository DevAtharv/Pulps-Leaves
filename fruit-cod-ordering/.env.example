FLASK_ENV=development
SECRET_KEY=replace-this-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
REQUIRE_CUSTOMER_LOGIN=true

# Razorpay test checkout
RAZORPAY_ENABLED=true
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-test-secret

# Google Maps address picker
GOOGLE_MAPS_API_KEY=replace-with-browser-api-key

# Google customer login:
# Create an OAuth web client in Google Cloud and add:
# https://pulpsandleaves.com/auth/google/callback
# https://www.pulpsandleaves.com/auth/google/callback
# http://127.0.0.1:5001/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Google Sheets mode:
# - auto: use Google Sheets when credentials are present, otherwise local Excel fallback
# - sheets: require Google Sheets and fail fast if credentials are missing
# - local: use data/orders.xlsx for local development
STORAGE_MODE=auto
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET_NAME=Orders
GOOGLE_DAILY_WORKSHEETS=true
GOOGLE_CREDENTIALS_FILE=credentials.json
# For Vercel, paste the full one-line service-account JSON into GOOGLE_CREDENTIALS_JSON instead of uploading credentials.json.
GOOGLE_CREDENTIALS_JSON=
LOCAL_ORDERS_FILE=data/orders.xlsx
LOCAL_CUSTOMERS_FILE=data/customers.xlsx

SUPPORT_PHONE=+91 98354 96666
SUPPORT_EMAIL=support@pulpsandleaves.example
META_VERIFY_TOKEN=
WHATSAPP_VERIFY_TOKEN=
OUTBOUND_CONFIRMATION_SECRET=

# Optional AI parser. Leave disabled until you have a compatible endpoint.
AI_PARSER_ENABLED=false
AI_PARSER_ENDPOINT=
AI_PARSER_API_KEY=
AI_PARSER_MODEL=
